# Astik Das Portfolio — Environment Configuration Example
# Copy this file to .env and fill in your values (do not commit .env to GitHub)

# Option A: Web3Forms (Recommended — free, forward messages directly to your inbox without a server)
# Get your free key at https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=

# Option B: Custom Endpoint (e.g., Formspree, Basin, or your own FastAPI/Express endpoint)
# e.g., https://formspree.io/f/your_form_id
VITE_CONTACT_FORM_ENDPOINT=

# Optional: Base path for hosting on a subdirectory (e.g., /myPortfolio/ for GitHub Pages)
# Defaults to './' for root domains and Vercel
VITE_BASE_PATH=./

